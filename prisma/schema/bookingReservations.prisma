model BookingReservation {
  id                   String                   @id @default(uuid()) @map("reservation_id")
  reservationReference String                   @unique @map("reservation_reference")
  customerId           String                   @map("customer_id")
  listingId            String                   @map("listing_id")
  variantId            String?                  @map("variant_id")
  bookingFormat        BookingFormat            @map("booking_format")
  listingSlotId        String?                  @map("listing_slot_id")
  dateRangeId          String?                  @map("date_range_id")
  selectedDate         DateTime?                @map("selected_date")
  selectedDates        Json?                    @map("selected_dates")
  participantCount     Int                      @default(1) @map("participant_count")
  currency             String                   @default("INR") @map("currency")
  paymentMethod        String?                  @map("payment_method")
  inventoryReserved    Boolean                  @default(false) @map("inventory_reserved")
  pricingDetails       Json                     @map("pricing_details")
  bookingPayload       Json                     @map("booking_payload")
  status               BookingReservationStatus @default(PENDING_PAYMENT) @map("status")
  expiresAt            DateTime                 @map("expires_at")
  reservedAt           DateTime                 @default(now()) @map("reserved_at")
  releasedAt           DateTime?                @map("released_at")
  completedAt          DateTime?                @map("completed_at")
  razorpayOrderId      String?                  @unique @map("razorpay_order_id")
  razorpayPaymentId    String?                  @unique @map("razorpay_payment_id")
  razorpaySignature    String?                  @map("razorpay_signature")
  bookingId            String?                  @unique @map("booking_id")
  failureReason        String?                  @db.Text @map("failure_reason")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  @@index([customerId, status, expiresAt])
  @@index([listingSlotId, status, expiresAt])
  @@index([dateRangeId, status, expiresAt])
  @@map("booking_reservations")
}
